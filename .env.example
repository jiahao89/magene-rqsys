PORT=8787
DATABASE_URL=postgres://rq_sys:change-me@localhost:5432/rq_sys
# Server-side Teambition credentials and source configuration.
GATEWAY_API_KEY=
TEAMBITION_GATEWAY_URL=
TEAMBITION_PROJECT_ID=
TEAMBITION_REQUIREMENT_TYPE_ID=

# Approved AI provider credentials, server-side only.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional bearer token guarding local API writes (server-factory entry only).
# Distinct from GATEWAY_API_KEY, which authenticates the Teambition gateway.
RQSYS_API_TOKEN=

# Local development identity (server entry only). Leave EMPTY for fail-closed behaviour:
# the API then rejects every protected route. Set it to an arbitrary local-only user id to
# let the local workbench exercise the real API on this machine. Three guards apply:
#   1. this variable must be explicitly set (empty = disabled);
#   2. the API refuses to enable it when NODE_ENV=production, whatever the value;
#   3. only loopback requests (localhost/127.0.0.1) are accepted.
# The Vite dev server injects the matching header when it sees the same variable.
# Never a production identity path: the target environment gets identity from Miaoda's
# trusted req.userContext.
RQSYS_LOCAL_IDENTITY=
# Optional header override; defaults to the Miaoda contract header (x-rqsys-platform-user-id).
RQSYS_LOCAL_IDENTITY_HEADER=

# Feishu Base push (server-side only; push adapter activates when all four are set).
# FEISHU_APP_ID / FEISHU_APP_SECRET: app credentials for tenant_access_token.
# BASE_APP_TOKEN / BASE_TABLE_ID: target bitable app/table.
# BASE_FIELDS_JSON: optional field-name map override (defaults follow the POC schema).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
BASE_APP_TOKEN=
BASE_TABLE_ID=
BASE_FIELDS_JSON=

# Local dev worker poll loop (WORKER_POLL_MS unset = disabled; target scheduling uses Miaoda automation).
WORKER_POLL_MS=
WORKER_ID=local-worker

# Local development only: bound how many requirements one sync queues for AI analysis.
# Import and source snapshots always cover every requirement, so nothing is hidden from the
# import; only the AI fan-out is bounded. Unset or 0 = no bound. Never set this in the target
# environment, where every new requirement must be analysed.
RQSYS_MAX_ANALYSIS_PER_SYNC=

# Enable only in Miaoda dev when BASE_APP_TOKEN/BASE_TABLE_ID point to the approved test Base.
# This exposes a fixed, synthetic one-record sync endpoint; never enable in online.
RQSYS_ENABLE_TEST_FIXTURES=
