PORT=8787
DATABASE_URL=postgres://rq_sys:change-me@localhost:5432/rq_sys
# Optional pool size for the local API (default 10). Push locks, requirement advisory locks and
# worker heartbeats all hold connections; raise only if the database allows more.
PG_POOL_MAX=
# Server-side Teambition credentials. Project/type IDs and the field map live in the
# database (source configuration), not here.
GATEWAY_API_KEY=
TEAMBITION_GATEWAY_URL=

# Approved AI provider credentials, server-side only.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Optional; AI_TEMPERATURE=none omits temperature for models that reject non-default values.
AI_TIMEOUT_MS=
AI_TEMPERATURE=

# Optional bearer token guarding local API writes (server-factory entry only).
# Distinct from GATEWAY_API_KEY, which authenticates the Teambition gateway.
RQSYS_API_TOKEN=

# Local development identity (server entry only). Leave EMPTY for fail-closed behaviour:
# the API then rejects every protected route. Set it to an arbitrary local-only user id to
# let the local workbench exercise the real API on this machine. Three guards apply:
#   1. this variable must be explicitly set (empty = disabled);
#   2. the API refuses to enable it when NODE_ENV=production, whatever the value;
#   3. only loopback requests (localhost/127.0.0.1) are accepted.
# The Vite dev server injects the matching header when it sees the same variable.
# Never a production identity path: the target environment gets identity from Miaoda's
# trusted req.userContext. NODE_ENV=production also refuses the local identity above.
NODE_ENV=
RQSYS_LOCAL_IDENTITY=
# Optional header override; defaults to the Miaoda contract header (x-rqsys-platform-user-id).
RQSYS_LOCAL_IDENTITY_HEADER=

# Feishu Base push (server-side only; push adapter activates when all four are set).
# FEISHU_APP_ID / FEISHU_APP_SECRET: app credentials for tenant_access_token.
# BASE_APP_TOKEN / BASE_TABLE_ID: target bitable app/table.
# BASE_FIELDS_JSON: optional field-name map override (defaults follow the POC schema).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
BASE_APP_TOKEN=
BASE_TABLE_ID=
BASE_FIELDS_JSON=
# 5b 收集表同步（与上面的 PM「数据表」分开，绝不覆盖 BASE_TABLE_ID）：
# BASE_INTAKE_TABLE_ID 指向「需求收集表」；留空则整个收集表同步关闭。
# BASE_INTAKE_FIELDS_JSON 可覆盖单个字段名（默认：标题/描述/来源渠道/需求类型/产品型号/
# 功能模块/约束说明/补充链接/提出人/系统需求 ID/同步状态/同步说明/同步时间）。
# BASE_INTAKE_SYNC_INTERVAL_MS 同步间隔，默认 60000。
BASE_INTAKE_TABLE_ID=
BASE_INTAKE_FIELDS_JSON=
BASE_INTAKE_SYNC_INTERVAL_MS=
# 数据源页「多维表格需求收集表」卡片展示的分享地址（只读展示，不参与同步）。
BASE_FORM_SHARE_URL=
# 所有 Base 调用的最小间隔（毫秒，默认 100 ≈ 10 次/秒）；0 = 不节流，只保留串行化。
BASE_MIN_INTERVAL_MS=
# Optional Q2 duplicate-row marking (no notification). Only these two text fields are written on
# duplicate/ignore decisions; omit the section to disable. Example:
# BASE_FIELDS_JSON={"duplicate":{"mark":"RQ重复标记","canonicalLink":"RQ主记录链接"}}
# 5c-2 optional: write the PM table's 来源方式 single-select on push (unset = never written).
# BASE_FIELDS_JSON={"sourceMethod":"来源方式"}
# Optional direct link for the requirement detail page. Must be https and contain {recordId}, e.g.
# https://<tenant>.feishu.cn/base/<app>?table=<table>&record={recordId}. Unset = copy-ID only.
RQSYS_BASE_RECORD_URL_TEMPLATE=
# Same, for the group pool's own Base (0031). The group pool never falls back to the product template:
# unset = the group detail page offers copy-ID only.
RQSYS_GROUP_BASE_RECORD_URL_TEMPLATE=
# 0031 集团池：独立 Base（与产品「数据表」分开）。缺任一配置即关闭集团池推送，
# 该池需求推送记 base_config_missing 终态，绝不回落产品表。
GROUP_BASE_APP_TOKEN=
GROUP_BASE_TABLE_ID=
# 可选：覆盖集团池字段名。默认映射（描述/提出人/产品型号）由代码内置。
GROUP_BASE_FIELDS_JSON=
# 集团池「TB链接」派生用的任务地址前缀（默认 https://teambition.magene.cn/task）。
RQSYS_TEAMBITION_TASK_BASE_URL=

# Optional ops alert: Feishu custom bot webhook (https only). When set, each scheduler tick posts a
# summary of failed / stuck pipeline jobs, de-duplicated per signature for the cooldown window.
# The webhook URL is a credential — keep it in the platform env, never in the repository.
RQSYS_ALERT_WEBHOOK_URL=
# Minimum minutes between repeats of the same alert (default 360).
RQSYS_ALERT_COOLDOWN_MINUTES=

# 通知深链的工作台地址（缺省用正式工作台地址），用于 Base 通知里的需求按钮。
RQSYS_WEB_BASE_URL=
# 产品池兜底收件人：实质变更/AI 重试成功时没有负责人，才发给这个 user_id（32 位十六进制）。
# 集团池不使用：集团池没有执行人就不发通知，也不回落 PM Leader。
RQSYS_PM_LEADER_USER_ID=

# I3-3: pause automatic analysis enqueue when the AI provider keeps rate-limiting.
# RQSYS_AI_PAUSE_THRESHOLD=3          # rate_limited failures within the window
# RQSYS_AI_PAUSE_WINDOW_MINUTES=10
# RQSYS_AI_PAUSE_MINUTES=30           # pause duration before automatic recovery
RQSYS_AI_PAUSE_THRESHOLD=
RQSYS_AI_PAUSE_WINDOW_MINUTES=
RQSYS_AI_PAUSE_MINUTES=

# Local dev worker poll loop (WORKER_POLL_MS unset = disabled; target scheduling uses Miaoda automation).
WORKER_POLL_MS=
WORKER_ID=local-worker
# 作业认领租约（毫秒，默认 30000）；长任务按 1/3 周期续约。
WORKER_LEASE_MS=

# Local development only: bound how many requirements one sync queues for AI analysis.
# Import and source snapshots always cover every requirement, so nothing is hidden from the
# import; only the AI fan-out is bounded. Unset or 0 = no bound. Never set this in the target
# environment, where every new requirement must be analysed.
RQSYS_MAX_ANALYSIS_PER_SYNC=

# Optional standalone local directory search only; never set this for Miaoda production.
# The caller must supply/refresh a user token with contact:user:search. Miaoda uses platform contacts.
FEISHU_USER_ACCESS_TOKEN=
