PORT=8787
DATABASE_URL=postgres://rq_sys:change-me@localhost:5432/rq_sys
# Server-side Teambition credentials and source configuration.
GATEWAY_API_KEY=
TEAMBITION_GATEWAY_URL=
TEAMBITION_PROJECT_ID=
TEAMBITION_REQUIREMENT_TYPE_ID=

# Approved AI provider credentials, server-side only.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional bearer token guarding local API writes (server-factory entry only).
# Distinct from GATEWAY_API_KEY, which authenticates the Teambition gateway.
RQSYS_API_TOKEN=

# Feishu Base push (server-side only; push adapter activates when all four are set).
# FEISHU_APP_ID / FEISHU_APP_SECRET: app credentials for tenant_access_token.
# BASE_APP_TOKEN / BASE_TABLE_ID: target bitable app/table.
# BASE_FIELDS_JSON: optional field-name map override (defaults follow the POC schema).
FEISHU_APP_ID=
FEISHU_APP_SECRET=
BASE_APP_TOKEN=
BASE_TABLE_ID=
BASE_FIELDS_JSON=

# Local dev worker poll loop (WORKER_POLL_MS unset = disabled; target scheduling uses Miaoda automation).
WORKER_POLL_MS=
WORKER_ID=local-worker

# Enable only in Miaoda dev when BASE_APP_TOKEN/BASE_TABLE_ID point to the approved test Base.
# This exposes a fixed, synthetic one-record sync endpoint; never enable in online.
RQSYS_ENABLE_TEST_FIXTURES=
