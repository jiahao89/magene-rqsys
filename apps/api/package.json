{
  "name": "@rq-sys/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import=tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file=../../.env --import=tsx src/db/migrate.ts",
    "test": "node --import=tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
